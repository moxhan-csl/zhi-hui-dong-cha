# 复制为 .env 后填写；.env 不要提交、不要进镜像。
#   cp .env.example .env && chmod 600 .env
# compose 启动时缺任何一项带 :? 的变量都会直接报错退出，不会静默用弱默认值起来。
#
# 这套部署不建数据库容器：MySQL / Redis / pgvector 用服务器上已经跑着的那套。
# 下面三组主机+口令填的就是那套实例的真实连接信息，容器通过 host.docker.internal 访问宿主机。

# ---------- 对外端口 ----------
# 前端（nginx）监听端口。80 被占用时改成 8081 等
HTTP_PORT=80
# 后端 8080 在宿主机上绑定的端口（只绑 127.0.0.1，供调试和验收脚本直连；外部访问走前端反代）
API_PORT=8080

# ---------- 数据服务地址 ----------
# 保持 host.docker.internal 即可（compose 里已用 host-gateway 解析到宿主机）。
# 若这些服务与容器不在同一台机器，填它们的实际 IP 或域名。
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
PG_HOST=host.docker.internal
PG_PORT=5432

# ---------- 业务库 MySQL（现有实例） ----------
MYSQL_DATABASE=zhihu_dongcha
# 后端自身的启动账号。application.yml 现在**不再保留任何兜底账号/口令**（D-29、D-21），
# 留空就是拿空凭据去连库、连不上直接启动失败——这是有意的，不给静默连到别处去的机会。
# 沿用开发机那套同一个账号意味着：线上服务和你的开发进程读写同一个库、同一批表，
# 改表结构与删数据会互相影响。要隔离就在那套实例里单独建库建账号（见 docs/DEPLOY.md 第 13.3 节）。
MYSQL_USER=mysql
MYSQL_PASSWORD=root

# ---------- 向量库 PostgreSQL / pgvector（现有实例） ----------
PG_DATABASE=kbqa
PG_USER=postgres
PG_PASSWORD=root

# ---------- Redis（现有实例） ----------
REDIS_PASSWORD=root

# ---------- 鉴权 ----------
# JWT HS256 密钥，必须 >= 32 字节，留空或太短会让后端启动即失败。生成：
#   openssl rand -base64 48 | tr -d '=+/' | cut -c1-48
# 换密钥等于强制所有人重新登录，已签发的 token 全部失效
JWT_SECRET=replace-with-48-chars-from-openssl-rand

# ---------- 大模型（阿里 DashScope / 通义千问） ----------
# 必填且不能留空：留空时 compose 会拒绝启动。真实密钥只存在于这台机器的 .env 里，
# application.yml 已不再保留默认值。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_PROVIDER=openai
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_CHAT_MODEL=qwen-plus
# 无外网/不想产生调用费用时：LLM_PROVIDER=mock，并把 LLM_API_KEY 填成任意非空占位值。
# 但 mock **只能出文字，不能出向量**：问答会返回本地模板式回答，文档入库与检索会直接失败
# （报错说"当前没有可用的真实 embedding 服务"），这是 D-14 有意的设计——哈希假向量和
# text-embedding-v3 同为 1024 维，写进去不报错，却会静默污染检索质量且事后无法与真向量区分。
# 确实要在本机用假向量把流程跑通时，才把下面这项设成 true（每次写入都有一条 WARN）。
# 线上保持 false：一旦设成 true，检索分数就不再可信。
LLM_ALLOW_HASH_VECTORS=false

# ---------- 其他 ----------
# 首次启动（users 表为空）创建 admin@corp.com 时用的口令。
# 留空 = 后端随机生成一个，只在启动日志里打印一次，之后必须自己去改。
# 库里已有用户时这项不再生效（不会重置任何人的密码）。
ADMIN_INIT_PASSWORD=
# 监控中心的当日成本阈值（单位：元）。这是配置项，不是测量值：
# 前端"阈值 600"显示的就是它，改了要重建 backend 容器才生效。
MONITOR_COST_THRESHOLD=600
# 同源部署（前端容器反代 /api）时浏览器不做跨域检查，这项实际不生效；
# 只有前端另地部署、直接跨域调后端时才填成前端站的 origin。
CORS_ORIGINS=http://localhost
# 构建前端时使用的 npm 源（本机 npm 用，服务器上不装 Node）；海外开发机可改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com
# 后端 JVM 参数；MaxRAMPercentage 让堆随容器内存上限自适应
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8

# ---------- 问答护栏（全部可选，注释掉即用 yml 默认值） ----------
# 一次问答会占住一个工作线程直到模型返回（最长 = LLM_TIMEOUT 秒）。
# 在途上限是"排队不崩溃"的闸门：超出的提问直接拒，返回可重试的错误（D-31）。
# 单用户同时在途问答数
#CHAT_MAX_INFLIGHT_PER_USER=2
# 全站同时在途问答数（要小于后端工作线程容量 64，给登录/文档页留余量）
#CHAT_MAX_INFLIGHT_TOTAL=24
# 单用户当日提问次数上限，0 = 不限制（D-32）
#CHAT_DAILY_REQUEST_LIMIT=200
# 当日估算费用熔断线（元）：达到后问答入口拒绝，次日零点自动恢复；0 = 不启用（D-32）。
# 金额口径与监控页同源（按 LLM_PRICE_PER_1K 估算，不是账单实数）。
# 建议高于 MONITOR_COST_THRESHOLD：让告警先响、熔断后到。
#CHAT_COST_BREAKER_YUAN=800
# 送进模型的会话上下文轮数（D-11）：1 轮 = 一问一答，3 = 最近 6 条；0 = 关闭多轮。
# 只作用于回答生成，检索仍只用当前问题原文；历史同时参与回答缓存 key。
# 调大 = 追问更连贯、每次提问的输入 token 更多（受 CHAT_COST_BREAKER_YUAN 约束）
#CHAT_CONTEXT_TURNS=3
# 忠实度判定未达阈值时重新生成几次（D-1）：0 = 关闭（回到"只标注不重试"），代码钳在 0-2。
# 只在真实模型判定"没过"时触发，检索不重跑；每多 1 就是那一个低质问题多花一次合成 + 一次判定。
# 重生成会先下发 revision 事件让前端作废上一版文字，所以界面上会看到回答重写一遍。
# 未通过校验的回答不回填缓存，所以同一个问题反复问会反复付费（受 CHAT_DAILY_REQUEST_LIMIT 约束）
#CHAT_QUALITY_RETRIES=1
# users 鉴权镜像重载周期（秒）：直接在库里停用账号后最迟这么久生效，不必重启（D-30 第一批）。
# 第八批起它还驱动 /api/health 里 documents 那个读数的刷新周期（仪表值，最多滞后一个周期）。
# 业务表不在这条链上：知识库/文档/会话/评测/审计现在每请求直读 MySQL（D-30 第八批）
#STORE_USER_CACHE_TTL=60
# 后端自身的上传体积上限（MB）。线上 nginx 另有一道，本机裸跑时只有这一道（D-16）
#UPLOAD_MAX_MB=50
